# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Database ---
# Used automatically inside Docker Compose (points at the `db` service).
# For running the backend outside Docker, point this at your Supabase/Railway
# Postgres connection string instead.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lenny_assistant

# --- LLM provider toggle ---
# "ollama" (local, mandatory for the demo) or "groq" (cloud, free tier).
# This is the one variable that changes which model answers -- no code
# change needed.
LLM_PROVIDER=ollama
ENABLE_PROVIDER_FALLBACK=true

# Required only if LLM_PROVIDER=groq (or you want fallback to work).
# Get a free key at https://console.groq.com/keys (no card required).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Required for local mode. Install Ollama, then: `ollama pull llama3.1:8b`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- App ---
ENVIRONMENT=development
TRANSCRIPTS_DIR=app/../data/transcripts
RETRIEVAL_TOP_K=5
